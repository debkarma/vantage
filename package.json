{
  "name": "vantage",
  "version": "1.0.0",
  "description": "HTTP-level API testing tool — record, replay, generate test code",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "vantage": "./dist/cli.js"
  },
  "exports": {
    "./sdk": "./dist/sdk/express.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.tsx",
    "dev:sample": "cross-env VANTAGE_MODE=record nodemon --exec tsx sample-app/server.ts"
  },
  "keywords": [
    "api",
    "testing",
    "e2e",
    "record",
    "replay",
    "testcontainers",
    "mocking"
  ],
  "author": "debkarma",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/debkarma/vantage.git"
  },
  "dependencies": {
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "axios": "^1.18.1",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "ink": "^7.1.1",
    "react": "^19.2.7",
    "testcontainers": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "esbuild-jest": "^0.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
